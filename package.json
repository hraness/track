{
  "name": "@hraness/dawg",
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/dawg.git"
  },
  "homepage": "https://dawg.sh",
  "bugs": "https://github.com/hraness/dawg/issues",
  "description": "A local-first terminal music workstation with an agent-driven piano-roll interface.",
  "type": "module",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/fixtures/**",
    "!src/**/*-fixtures.ts",
    "core/**/*.ts",
    "!core/**/*.test.ts",
    "core/sdk/**",
    "tui/**/*.ts",
    "!tui/**/*.test.ts",
    "guides/*.md",
    "guides/index.ts",
    "guides/marks.ts",
    "CHANGELOG.md",
    "DAWG.md",
    "native/prebuilt/manifest.json",
    "native/prebuilt/*/libdawg_sink.*"
  ],
  "bin": {
    "dawg": "./src/main.ts"
  },
  "scripts": {
    "dawg": "bun run src/main.ts",
    "bench:perf": "bun bench/perf/run.ts",
    "sizes": "bun bench/sizes/matrix.ts",
    "test": "bun test",
    "screens": "bun test/screens/capture.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck && bun run format",
    "format": "prettier --check ."
  },
  "dependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "bun-types": "1.4.2",
    "prettier": "3.9.9"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
